@import "../../assets/icons.wxss";

.page{position:relative;width:100%;height:100vh;overflow:hidden;background:#f4f8fc}
.map{width:100%;height:100vh}

/* ============================================================
   顶部控制条：区域（乡镇）选择 + 聚焦切换 + 重定位。
   原标题卡 / 左下角区域按钮 / 右下角定位按钮 / 聚焦提示条四件浮层
   合并成一条；标题文案无信息量（tabBar 已标识页面），不再保留。
   聚焦态直接显示在区域选择上（蓝色底 + 点位计数），切换按钮紧随其后，
   符合「选了哪里、哪里被聚焦」的直觉。
   ============================================================ */
.map-header{position:absolute;top:26rpx;left:24rpx;right:24rpx;display:flex;align-items:center;min-height:84rpx;padding:8rpx;border:1rpx solid rgba(255,255,255,.86);border-radius:24rpx;background:rgba(255,255,255,.94);box-shadow:0 1rpx 2rpx rgba(14,77,100,.05),0 14rpx 32rpx rgba(14,77,100,.2),inset 0 1rpx 0 rgba(255,255,255,.95);backdrop-filter:blur(20rpx) saturate(1.4);z-index:100}
.header-region-picker{flex:1;min-width:0}
/* 区域选择：宿主只负责定位，不在 <picker> 自定义组件宿主上施加动画/transform/伪元素，
   视觉与按压反馈放在内部普通 view，与首页 location-picker 保持同一种结构。 */
.header-region{display:flex;align-items:center;min-height:68rpx;padding:0 20rpx;border-radius:18rpx;background:rgba(14,155,184,.08);transition:background var(--qd-t-fast) ease}
.header-region:active{background:rgba(14,155,184,.18)}
.header-region.focus{background:rgba(22,119,200,.12)}
.region-icon{width:26rpx;height:26rpx;margin-right:10rpx;opacity:.9}
.header-region-name{overflow:hidden;color:#123a4a;font-size:26rpx;font-weight:700;letter-spacing:.5rpx;text-overflow:ellipsis;white-space:nowrap}
.header-region-count{flex-shrink:0;margin-left:12rpx;padding:5rpx 14rpx;border-radius:999rpx;background:#1677c8;color:#fff;font-size:20rpx;font-weight:600}
.header-region-count.off{background:#c3d2dc;color:#4a6274}
.header-region-arrow{margin-left:8rpx;color:#7e98ab;font-size:20rpx}
.header-scope-action{flex-shrink:0;display:flex;align-items:center;min-height:68rpx;margin-left:8rpx;padding:0 20rpx;border-radius:18rpx;background:#1677c8;color:#fff;font-size:22rpx;font-weight:600;transition:transform var(--qd-t-fast) var(--qd-ease-spring)}
.header-scope-action:active{transform:scale(.94)}
.header-locate{display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;margin-left:8rpx;border-radius:18rpx;background:rgba(14,155,184,.08);transition:transform var(--qd-t-base) var(--qd-ease-spring),background var(--qd-t-base) ease}
.header-locate:active{transform:scale(.9);background:rgba(14,155,184,.18)}
.header-locate .ic{width:38rpx;height:38rpx}

/* ============================================================
   筛选栏（玻璃 + 滑块）
   ============================================================ */
.filter-bar{position:absolute;top:126rpx;right:24rpx;left:24rpx;display:flex;min-height:96rpx;padding:8rpx;border:1rpx solid rgba(255,255,255,.86);border-radius:24rpx;background:rgba(255,255,255,.94);box-shadow:0 1rpx 2rpx rgba(14,77,100,.05),0 12rpx 28rpx rgba(14,77,100,.16),inset 0 1rpx 0 rgba(255,255,255,.95);backdrop-filter:blur(20rpx) saturate(1.4);z-index:100}

.filter-slider{position:absolute;top:8rpx;bottom:8rpx;left:8rpx;width:calc((100% - 16rpx) / 4);border:1rpx solid rgba(14,155,184,.2);border-radius:18rpx;background:linear-gradient(180deg,rgba(14,155,184,.16) 0%,rgba(14,155,184,.06) 100%);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9);transition:transform .4s cubic-bezier(.34,1.4,.5,1);pointer-events:none}
.filter-bar.active-all .filter-slider{transform:translateX(0)}
.filter-bar.active-reservoir .filter-slider{transform:translateX(100%)}
.filter-bar.active-river .filter-slider{transform:translateX(200%)}
.filter-bar.active-soil .filter-slider{transform:translateX(300%)}

.filter-item{position:relative;display:flex;flex:1;align-items:center;justify-content:center;min-width:0;padding:13rpx 3rpx;border-radius:18rpx;color:#6b8798;font-size:22rpx;white-space:nowrap;z-index:1;transition:color var(--qd-t-base) ease,transform var(--qd-t-fast) var(--qd-ease-spring)}
.filter-item:active{transform:scale(.94)}
.filter-item.active{color:#0e4d64;font-weight:700}
.filter-dot{width:12rpx;height:12rpx;flex-shrink:0;margin-right:6rpx;border:3rpx solid #fff;border-radius:50%;box-shadow:0 1rpx 4rpx rgba(14,77,100,.22)}
.filter-dot.all{background:#0e9bb8}
.filter-dot.reservoir{background:#1f8fc4}
.filter-dot.river{background:#12a5ac}
.filter-dot.soil{background:#5f9e3a}

/* ============================================================
   底部说明条：乡镇分界线示意 + 点位计数（原右侧图例卡已删除——
   点位类型色点与筛选栏的色点完全同色同义，属重复信息）
   ============================================================ */
.map-note{position:absolute;left:24rpx;bottom:44rpx;display:flex;align-items:center;max-width:600rpx;padding:10rpx 18rpx;border-radius:999rpx;background:rgba(255,255,255,.85);box-shadow:0 6rpx 18rpx rgba(14,77,100,.14);z-index:90}
.map-note-line{width:26rpx;height:0;margin-right:10rpx;border-top:3rpx solid #0e6a80;border-radius:3rpx;flex-shrink:0}
.map-note-text{color:#5e7f90;font-size:21rpx;white-space:nowrap}

/* ============================================================
   底部站点面板：上滑入场
   ============================================================ */
.station-panel{position:absolute;right:18rpx;bottom:146rpx;bottom:calc(146rpx + env(safe-area-inset-bottom));left:18rpx;padding:30rpx 28rpx 28rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:30rpx;background:linear-gradient(180deg,#ffffff 0%,#fdfeff 100%);box-shadow:0 2rpx 4rpx rgba(14,77,100,.06),0 20rpx 48rpx rgba(14,77,100,.24),0 48rpx 90rpx rgba(14,77,100,.12),inset 0 1rpx 0 rgba(255,255,255,.95);z-index:200;animation:qd-slide-up-panel .42s cubic-bezier(.16,1,.3,1) both}
.panel-grabber{width:64rpx;height:6rpx;margin:-8rpx auto 16rpx;border-radius:999rpx;background:#dde8ef}
.panel-close{position:absolute;top:20rpx;right:20rpx;display:flex;align-items:center;justify-content:center;width:50rpx;height:50rpx;border-radius:50%;color:#6b8798;background:#eef6fb;font-size:32rpx;line-height:1;transition:transform var(--qd-t-fast) var(--qd-ease-spring),background var(--qd-t-fast) ease}
.panel-close:active{transform:scale(.88);background:#e2edf4}
.panel-header{display:flex;align-items:center;padding-right:55rpx}
.panel-icon{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;margin-right:18rpx;border-radius:22rpx;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}
.panel-icon .ic{width:40rpx;height:40rpx}
.panel-icon.reservoir{background:linear-gradient(150deg,#eaf8fd,#d7f0f9)}
.panel-icon.river{background:linear-gradient(150deg,#e6fbfb,#d5f4f4)}
.panel-icon.soil{background:linear-gradient(150deg,#f4fbe8,#e8f5d6)}
.panel-info{min-width:0;flex:1}
.panel-name{overflow:hidden;color:#123a4a;font-size:32rpx;font-weight:700;letter-spacing:.5rpx;text-overflow:ellipsis;white-space:nowrap}
.panel-address{margin-top:8rpx;overflow:hidden;color:#7e98ab;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}

.panel-status{
margin-right:56rpx;
padding:7rpx 13rpx;
border:1rpx solid rgba(14,155,184,.16);
border-radius:999rpx;
background:#e6f7fc;
color:#0e6a80;
font-size:22rpx;
font-weight:600;
}
.panel-status.warning,.panel-status.dry{color:#a96900;background:#fff8e8;border-color:rgba(212,154,42,.2)}
.panel-status.danger,.panel-status.drought{color:#c33d25;background:#fff2f0;border-color:rgba(217,95,95,.2)}
.panel-status.wet{color:#0e6a80;background:#e6f7fc;border-color:rgba(14,155,184,.14)}
.panel-status.unknown{color:#5e7f90;background:#eef4f8;border-color:rgba(94,127,144,.2)}

.panel-data{display:flex;margin-top:26rpx;padding:20rpx 0;border-top:1rpx solid #eaf1f6;border-bottom:1rpx solid #eaf1f6}
.data-item{flex:1;padding:0 14rpx;border-right:1rpx solid #eef4f8}
.data-item:last-child{border-right:0}
.data-label{color:#8399aa;font-size:22rpx}
.data-value{margin-top:8rpx;color:#0e4d64;font-size:32rpx;font-weight:700;letter-spacing:-.5rpx}
.data-unit{margin-left:3rpx;color:#7390a5;font-size:20rpx;font-weight:400}
.panel-footer{display:flex;align-items:center;justify-content:space-between;margin-top:22rpx}
.update-time{color:#8aa5b4;font-size:22rpx}
.detail-btn{position:relative;overflow:hidden;padding:22rpx 28rpx;border-radius:18rpx;color:#fff;background:linear-gradient(135deg,#0e4d64 0%,#0b4f8a 100%);font-size:23rpx;font-weight:600;letter-spacing:.5rpx;box-shadow:0 8rpx 18rpx rgba(14,77,100,.28),inset 0 1rpx 0 rgba(255,255,255,.24);transition:transform var(--qd-t-fast) var(--qd-ease-spring)}
.detail-btn:active{transform:scale(.95)}

/* ===== 图例补充分级（旧图例卡已并入筛选栏与底部说明条，仅保留触控命中区规则） ===== */

/* ===== 触控命中区补强（≥88rpx≈44pt） ===== */
.filter-item{position:relative}
.filter-item::after{position:absolute;top:-8rpx;right:0;bottom:-8rpx;left:0;content:''}
.panel-close::after{position:absolute;top:-19rpx;right:-19rpx;bottom:-19rpx;left:-19rpx;content:''}
.detail-btn{position:relative}
.detail-btn::after{position:absolute;top:-8rpx;right:0;bottom:-8rpx;left:0;content:''}

/* 站点数据获取失败横幅：紧贴筛选栏下方（聚焦提示已并入顶部控制条） */
.map-load-failed{position:absolute;top:236rpx;left:24rpx;display:flex;align-items:center;gap:16rpx;padding:14rpx 22rpx;border:1rpx solid rgba(217,95,95,.24);border-radius:20rpx;background:rgba(255,246,245,.96);box-shadow:0 10rpx 26rpx rgba(14,77,100,.16);z-index:100}
.map-load-failed:active{transform:scale(.98)}
.map-load-failed-text{color:#a03a2a;font-size:25rpx}
.map-load-failed-retry{padding:6rpx 18rpx;border-radius:999rpx;color:#c33d25;background:#fff2f0;border:1rpx solid rgba(217,95,95,.26);font-size:23rpx;font-weight:600}
