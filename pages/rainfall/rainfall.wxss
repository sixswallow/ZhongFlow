@import "../../assets/icons.wxss";

.page{min-height:100vh;padding-bottom:calc(156rpx + env(safe-area-inset-bottom));background:#f4f8fc}

/* ============================================================
   天气头部
   ============================================================ */
.header{position:relative;overflow:hidden;padding-bottom:48rpx}
.header-bg{position:absolute;top:0;right:0;bottom:0;left:0;border-radius:0 0 36rpx 36rpx;background:radial-gradient(circle at 88% 8%,rgba(255,255,255,.28),transparent 28%),radial-gradient(circle at 8% 105%,rgba(14,155,184,.35),transparent 40%),linear-gradient(150deg,#0e4d64 0%,#0b4f8a 52%,#2e86b8 100%);box-shadow:0 18rpx 42rpx rgba(14,77,100,.24)}
.header-aurora{position:absolute;top:-150rpx;left:-110rpx;width:420rpx;height:420rpx;border-radius:50%;background:radial-gradient(circle,rgba(94,212,235,.4) 0%,rgba(94,212,235,0) 70%);animation:qd-aurora 24s ease-in-out infinite}
.header-ring{position:absolute;border:2rpx solid rgba(255,255,255,.18);pointer-events:none}
.ring-a{right:-70rpx;top:120rpx;width:230rpx;height:230rpx;border-radius:50% 50% 46% 54%;animation:qd-float 11s ease-in-out infinite}

.status-bar,.header-content{position:relative;z-index:1}
.header-content{padding:16rpx 24rpx 0;color:#fff}

.location-row{display:flex;justify-content:center;margin-bottom:34rpx}
.location-picker{display:flex;align-items:center;padding:16rpx 22rpx;border:1rpx solid rgba(255,255,255,.36);border-radius:999rpx;background:rgba(255,255,255,.16);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.36),0 6rpx 18rpx rgba(6,38,54,.16);backdrop-filter:blur(16rpx) saturate(1.3);transition:transform var(--qd-t-fast) var(--qd-ease-spring)}
.location-picker:active{transform:scale(.96)}
.location-icon{width:27rpx;height:27rpx;margin-right:9rpx}
.location-text{margin-right:9rpx;font-size:30rpx;font-weight:700;letter-spacing:.5rpx}
.location-arrow{font-size:20rpx;opacity:.8}

.current-weather{text-align:center}
.temp-block{margin-bottom:34rpx}
.temperature{display:block;margin-bottom:14rpx;font-size:124rpx;font-weight:200;line-height:1;letter-spacing:-4rpx;text-shadow:0 6rpx 26rpx rgba(6,38,54,.26)}
.weather-desc{font-size:31rpx;letter-spacing:1rpx;opacity:.95}
.extra-block{display:flex;align-items:center;justify-content:center;margin:0 8rpx;padding:20rpx 0;border:1rpx solid rgba(255,255,255,.3);border-radius:24rpx;background:rgba(255,255,255,.14);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.34);backdrop-filter:blur(18rpx) saturate(1.3)}
.extra-item{display:flex;flex:1;flex-direction:column;align-items:center}
.extra-label{margin-bottom:7rpx;font-size:22rpx;opacity:.76}
.extra-value{font-size:28rpx;font-weight:600;letter-spacing:-.5rpx}
.extra-divider{width:1rpx;height:44rpx;background:linear-gradient(180deg,rgba(255,255,255,0),rgba(255,255,255,.42),rgba(255,255,255,0))}

.weather-placeholder{padding:38rpx 0 22rpx}
.header-sk-temp{width:230rpx;height:112rpx;margin:0 auto 18rpx;border-radius:24rpx;background:rgba(255,255,255,.2)}
.header-sk-desc{width:180rpx;height:26rpx;margin:0 auto;background:rgba(255,255,255,.18)}

/* ============================================================
   内容区（卡片上叠头部）
   ============================================================ */
.content{position:relative;margin-top:-24rpx;padding:0 24rpx}

.data-state-card{position:relative;margin-bottom:22rpx;padding:48rpx 32rpx;border:1rpx solid #ffe7ba;border-radius:28rpx;background:linear-gradient(180deg,#fffdf7 0%,#fff8ec 100%);box-shadow:var(--qd-e2),var(--qd-hairline-top);text-align:center}
.data-state-mark{width:64rpx;height:64rpx;margin:0 auto 18rpx;opacity:.7}
.data-state-title{color:#9c6500;font-size:30rpx;font-weight:700}
.data-state-desc{margin-top:14rpx;color:#8a7960;font-size:24rpx;line-height:1.6}
.data-state-retry{display:inline-block;margin-top:26rpx;padding:22rpx 40rpx;border-radius:999rpx;color:#fff;background:linear-gradient(135deg,#0e4d64 0%,#0b4f8a 100%);font-size:24rpx;font-weight:600;box-shadow:0 10rpx 22rpx rgba(14,77,100,.26),inset 0 1rpx 0 rgba(255,255,255,.24);transition:transform var(--qd-t-fast) var(--qd-ease-spring)}
.data-state-retry:active{transform:scale(.95)}

.card{position:relative;margin-bottom:22rpx;padding:30rpx 28rpx;border:1rpx solid rgba(215,232,240,.92);border-radius:28rpx;background:linear-gradient(180deg,#ffffff 0%,#fdfeff 100%);box-shadow:var(--qd-e2),var(--qd-hairline-top)}
.card-title{display:flex;align-items:center;margin-bottom:22rpx;color:#123a4a;font-size:32rpx;font-weight:700;letter-spacing:.5rpx}
.card-title::before{width:7rpx;height:28rpx;margin-right:12rpx;border-radius:6rpx;background:linear-gradient(180deg,#0e9bb8 0%,#0e4d64 100%);box-shadow:0 0 12rpx rgba(14,155,184,.4);content:''}
.card-title .update-time{margin-left:auto;color:#7190a5;font-size:22rpx;font-weight:400}

/* 骨架块 */
.sk-block{width:100%;height:24rpx}
.sk-block.title{height:34rpx;margin-bottom:24rpx;border-radius:14rpx}
.sk-block.title.short{width:52%}
.sk-block.chart{height:240rpx;border-radius:20rpx;background:linear-gradient(180deg,#f2f8fc 0%,#e9f1f8 100%)}
.sk-block.chart.short{height:170rpx}
.sk-block.line{height:20rpx;margin-top:20rpx}

/* ============================================================
   气象云图
   ============================================================ */
.weather-layer{overflow:hidden;border-color:rgba(210,234,250,.95);background:linear-gradient(165deg,#ffffff 0%,#f3f9fd 100%)}
.layer-subtitle{margin:-4rpx 0 18rpx 18rpx;color:#7190a5;font-size:22rpx;line-height:1.5}
.visual-canvas-shell{margin-top:12rpx;padding:8rpx;border-radius:24rpx;background:linear-gradient(180deg,#fbfdff 0%,#eef6fb 100%);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9),inset 0 0 0 1rpx rgba(215,232,240,.7)}
.layer-canvas{display:block;border-radius:18rpx;background:#e9f6fc}
/* 缩放只走手势（双指/单指），这里只留「重定位」与当前视野 */
.layer-zoom-bar{display:flex;align-items:center;margin-top:16rpx}
.layer-recenter{position:relative;padding:16rpx 32rpx;border-radius:999rpx;color:#0e4d64;font-size:22rpx;font-weight:700;background:linear-gradient(180deg,#eaf7fc 0%,#e1f2fa 100%);box-shadow:0 4rpx 12rpx rgba(14,77,100,.1),inset 0 1rpx 0 rgba(255,255,255,.9)}
.layer-recenter::after{position:absolute;top:-10rpx;right:-8rpx;bottom:-10rpx;left:-8rpx;content:''}
.layer-zoom-tip{margin-left:16rpx;color:#7891a4;font-size:22rpx}
/* 乡镇取景选择器：放在视野条里，一眼就知道现在看的是哪一档 */
.layer-scope{display:flex;align-items:center;padding:6rpx 16rpx;border:1rpx solid rgba(14,155,184,.28);border-radius:999rpx;background:rgba(255,255,255,.9);color:#12475c;font-size:22rpx;font-weight:600;transition:border-color var(--qd-t-fast) ease}
.rain-canvas{display:block;border-radius:18rpx;background:#f3f9fd}
.visual-controls{display:flex;align-items:center;margin-top:22rpx}
.visual-play{min-width:80rpx;margin-right:14rpx;padding:19rpx 20rpx;border-radius:18rpx;color:#0e4d64;background:linear-gradient(180deg,#eaf7fc 0%,#e1f2fa 100%);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9);font-size:22rpx;font-weight:700;text-align:center;transition:all var(--qd-t-base) var(--qd-ease)}
.visual-play:active{transform:scale(.94)}
.visual-play.playing{color:#fff;background:linear-gradient(135deg,#0e4d64 0%,#0e9bb8 100%);box-shadow:0 8rpx 18rpx rgba(14,155,184,.32),inset 0 1rpx 0 rgba(255,255,255,.28)}
.timeline-progress{flex:1;min-width:0}
.timeline-slider{margin:0 8rpx}
.timeline-times{display:flex;justify-content:space-between;margin-top:-6rpx;padding:0 16rpx;color:#7791a4;font-size:20rpx;line-height:1.4}
.timeline-now{color:#0e4d64;font-weight:700;font-size:24rpx}
.layer-legend{display:flex;flex-wrap:wrap;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #eef4f8;color:#6f899c;font-size:22rpx}
.layer-legend-item{display:flex;align-items:center;margin:0 18rpx 10rpx 0}
.legend-dot{display:inline-block;width:13rpx;height:13rpx;margin-right:6rpx;border:2rpx solid rgba(255,255,255,.9);border-radius:50%;box-shadow:0 1rpx 4rpx rgba(14,77,100,.18)}
.legend-dot.lv-1{background:#8ccf6f}
.legend-dot.lv-2{background:#f7d549}
.legend-dot.lv-3{background:#f2873c}
.legend-dot.lv-4{background:#d93b3b}
.legend-dot.wind{background:linear-gradient(135deg,#0b4f8a 0%,#5ed4eb 100%)}
/* —— 气象图层：图层切换 / 重试 / 来源 —— */
/* 全屏查看：定位到悬浮 tabBar 之上（tabBar z-index:999），底部让出 tabBar 的高度 */
.layer-zoom-hint{margin-top:14rpx;color:#a3b8c6;font-size:22rpx;line-height:1.5}
.layer-switch{display:flex;margin-bottom:16rpx;padding:6rpx;border-radius:18rpx;background:linear-gradient(180deg,#eef6fb 0%,#e7f1f9 100%);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}
.layer-tab{flex:1;min-height:88rpx;color:#5e7f90;font-size:24rpx;line-height:88rpx;text-align:center;border-radius:14rpx;transition:color .24s ease,background .24s ease,box-shadow .24s ease}
.layer-tab.active{color:#fff;font-weight:700;background:linear-gradient(135deg,#0e4d64 0%,#0e9bb8 100%);box-shadow:0 8rpx 18rpx rgba(14,155,184,.28)}
.layer-retry{position:relative;margin:0 0 10rpx auto;padding:16rpx 28rpx;border-radius:999rpx;color:#0e4d64;font-size:22rpx;background:linear-gradient(180deg,#eaf7fc 0%,#e1f2fa 100%);box-shadow:0 4rpx 12rpx rgba(14,77,100,.14)}
.layer-retry::after{position:absolute;top:-14rpx;right:-10rpx;bottom:-14rpx;left:-10rpx;content:''}
.layer-source{margin-top:8rpx;color:#a3b8c6;font-size:22rpx;line-height:1.5}

/* ============================================================
   分钟级降水
   ============================================================ */
.rain-summary{margin-bottom:20rpx;padding:18rpx 22rpx;border-left:6rpx solid #0e4d64;border-radius:12rpx;color:#587287;background:linear-gradient(180deg,#f4faff 0%,#eef7ff 100%);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9);font-size:25rpx;line-height:1.6}
.minute-empty{margin-bottom:20rpx;padding:22rpx 24rpx;border:1rpx dashed #cfe3ee;border-radius:16rpx;background:linear-gradient(180deg,#f7fbfd 0%,#eef6fb 100%)}
.minute-empty-title{color:#4f7b91;font-size:26rpx;font-weight:600}
.minute-empty-reason{margin-top:10rpx;color:#5f87a0;font-size:23rpx;line-height:1.55}
.minute-empty-desc{margin-top:10rpx;color:#7d94a3;font-size:22rpx;line-height:1.55}
.rain-legend{display:flex;justify-content:center;margin-top:18rpx}
.legend-item{display:flex;align-items:center}
.legend-line{width:24rpx;height:8rpx;margin-right:8rpx;border-radius:4rpx}
.legend-line.rain{width:14rpx;height:26rpx;border-radius:5rpx;background:linear-gradient(180deg,#0b4f8a 0%,#9fd8ef 100%)}
.legend-text{color:#8aa5b4;font-size:22rpx}

/* ============================================================
   逐小时
   ============================================================ */
.hourly-scroll{white-space:nowrap}
.hourly-list{display:inline-flex;padding:6rpx 0}
.hourly-item{display:inline-flex;flex-direction:column;align-items:center;min-width:104rpx;margin-right:10rpx;padding:18rpx 22rpx;border:1rpx solid rgba(215,232,240,.72);border-radius:20rpx;background:linear-gradient(180deg,#fbfdff 0%,#f4f9fd 100%);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9);transition:transform var(--qd-t-base) var(--qd-ease-spring),background var(--qd-t-base) ease}
.hour-time{margin-bottom:12rpx;color:#8aa5b4;font-size:23rpx}
.hour-icon{margin-bottom:8rpx;font-size:39rpx}
.hour-rain{margin-bottom:8rpx;color:#0e6a80;font-size:22rpx}
.hour-rain.no-rain{color:#cbd6de}
.hour-temp{color:#123a4a;font-size:28rpx;font-weight:600}

/* ============================================================
   逐日
   ============================================================ */
.daily-item{display:flex;align-items:center;padding:19rpx 0;border-bottom:1rpx solid #eaf1f6}
.daily-item:last-child,.township-item:last-child{border-bottom:0}
.daily-date{width:100rpx;flex-shrink:0;color:#587287;font-size:25rpx}
.daily-weather{display:flex;align-items:center;width:180rpx;flex-shrink:0}
.daily-icon{margin-right:8rpx;font-size:31rpx}
.daily-desc{overflow:hidden;color:#587287;font-size:23rpx;text-overflow:ellipsis;white-space:nowrap}
.daily-temp{width:160rpx;flex-shrink:0;text-align:center}
.temp-high{color:#123a4a;font-size:27rpx;font-weight:600}
.temp-divider{margin:0 4rpx;color:#c5d2db}
.temp-low{color:#8aa5b4;font-size:25rpx}
.daily-rain{display:flex;flex:1;align-items:center;min-width:0}
.rain-bar-bg{flex:1;height:9rpx;margin-right:12rpx;overflow:hidden;border-radius:999rpx;background:#eaf0f4;box-shadow:inset 0 1rpx 2rpx rgba(14,77,100,.08)}
.rain-bar{height:100%;border-radius:inherit;background:linear-gradient(90deg,#91caff 0%,#0e4d64 100%);transform-origin:left center;animation:qd-bar-grow 1s var(--qd-ease-out) .15s both;transition:width .5s var(--qd-ease-out)}
.rain-prob{width:62rpx;color:#0e6a80;font-size:22rpx;text-align:right}
/* 数据源没给概率时的占位：与逐小时「--」同一套灰，位置对齐 */
.rain-prob-none{flex:1;color:#cbd6de;font-size:22rpx;text-align:right}

/* ============================================================
   乡镇短临
   ============================================================ */
.township-item{padding:22rpx 0;border-bottom:1rpx solid #eaf1f6;transition:background var(--qd-t-fast) ease}
.township-info{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.township-name{color:#123a4a;font-size:28rpx;font-weight:700;letter-spacing:.5rpx}
.township-status{padding:5rpx 13rpx;border-radius:999rpx;font-size:22rpx;font-weight:600}
.township-status.rain{color:#0e6a80;background:#e6f7fc;border:1rpx solid rgba(14,155,184,.16)}
.township-status.norain{color:#548e25;background:#f3f9e6;border:1rpx solid rgba(95,158,58,.16)}
.township-data{display:flex;justify-content:space-around;padding:18rpx 0;border:1rpx solid rgba(215,232,240,.7);border-radius:20rpx;background:linear-gradient(180deg,#f8fcfe 0%,#f1f8fc 100%);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}
.township-data .data-col{text-align:center}
.township-data .data-val{margin-bottom:5rpx;color:#0e4d64;font-size:30rpx;font-weight:700;letter-spacing:-.5rpx}
.township-data .data-label{color:#8aa5b4;font-size:22rpx}

.provider-info{display:flex;align-items:center;justify-content:space-between;padding:16rpx 8rpx 0}
.provider-text{color:#9db0bd;font-size:22rpx}
.refresh-btn{padding:18rpx 22rpx;border-radius:999rpx;color:#0e6a80;background:#eaf7fc;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9);font-size:23rpx;font-weight:600;transition:transform var(--qd-t-fast) var(--qd-ease-spring)}
.refresh-btn:active{transform:scale(.93)}

/* ===== 乡镇短临失败态 ===== */
.nowcast-error{display:flex;align-items:center;padding:24rpx 26rpx;border:1rpx solid #ffe7ba;border-radius:24rpx;background:linear-gradient(180deg,#fffdf7 0%,#fff8ec 100%);box-shadow:var(--qd-e2),var(--qd-hairline-top)}
.nowcast-error-mark{width:44rpx;height:44rpx;flex-shrink:0;margin-right:18rpx;opacity:.7}
.nowcast-error-copy{min-width:0;flex:1}
.nowcast-error-title{color:#9c6500;font-size:26rpx;font-weight:700}
.nowcast-error-desc{margin-top:8rpx;color:#8a7960;font-size:22rpx;line-height:1.5}
.nowcast-error-retry{position:relative;flex-shrink:0;margin-left:18rpx;padding:20rpx 26rpx;border-radius:18rpx;color:#fff;background:linear-gradient(135deg,#0e4d64 0%,#0b4f8a 100%);font-size:23rpx;font-weight:600;box-shadow:0 8rpx 18rpx rgba(14,77,100,.24),inset 0 1rpx 0 rgba(255,255,255,.24);transition:transform var(--qd-t-fast) var(--qd-ease-spring)}
.nowcast-error-retry::after{position:absolute;top:-12rpx;right:0;bottom:-12rpx;left:0;content:''}
.nowcast-error-retry:active{transform:scale(.95)}

/* ===== 卡片圆角裁剪 ===== */
.minute-rain,.hourly-forecast,.daily-forecast,.township-forecast{overflow:hidden}

/* ===== 触控命中区补强（≥88rpx≈44pt） ===== */
.location-picker{position:relative}
.location-picker::after{position:absolute;top:-12rpx;right:0;bottom:-12rpx;left:0;content:''}
.visual-play{position:relative}
.visual-play::after{position:absolute;top:-12rpx;right:0;bottom:-12rpx;left:0;content:''}
.refresh-btn{position:relative}
.refresh-btn::after{position:absolute;top:-12rpx;right:-8rpx;bottom:-12rpx;left:-8rpx;content:''}
.data-state-retry{position:relative}
.data-state-retry::after{position:absolute;top:-8rpx;right:0;bottom:-8rpx;left:0;content:''}

/* ==================== 未来降雨影响 ==================== */
.rain-impact{margin-bottom:22rpx}
.card-title .impact-grade{margin-left:auto;padding:6rpx 18rpx;border-radius:999rpx;font-size:22rpx;font-weight:700;background:#eef4f8;color:#5e7f90}
.impact-grade.light{background:#e6f7fc;color:#0e6a80}
.impact-grade.moderate{background:#e3f1f9;color:#0e5f86}
.impact-grade.heavy{background:#e8eefb;color:#0b4f8a}
.impact-grade.storm{background:#efeafb;color:#5a45a8}
.impact-spans{display:flex;align-items:stretch}
.impact-span{flex:1;min-width:0;text-align:center}
.impact-divider{width:1rpx;margin:6rpx 0;background:#e2eef5}
.impact-mm{color:#0b4f8a;font-size:46rpx;font-weight:700;line-height:1.15}
.impact-unit{margin-left:4rpx;color:#8aa5b4;font-size:22rpx;font-weight:400}
.impact-label{margin-top:6rpx;color:#7891a4;font-size:22rpx}
.impact-meta{margin-top:16rpx;color:#5e7f90;font-size:22rpx}
.impact-tip{margin-top:12rpx;padding:14rpx 18rpx;border-radius:14rpx;background:#f2f9fd;color:#26475f;font-size:22rpx;line-height:1.5}

/* 逐小时雨量柱：与雷达图例同一套色阶 */
.hour-bar-track{position:relative;width:40rpx;height:64rpx;margin:4rpx 0;border-radius:8rpx;background:#eef6fa;overflow:hidden}
.hour-bar{position:absolute;bottom:0;left:0;width:100%;border-radius:8rpx;background:#cfe9f5}
.hour-bar.light{background:#a8dff2}
.hour-bar.moderate{background:#35a3c4}
.hour-bar.heavy{background:#0b4f8a}
.hour-bar.storm{background:#6a4bb8}
/* 没取到雨量的小时用「未知」，与「确实 0mm」（--）必须能区分开 */
.hour-rain.unknown-rain{color:#b3c6d2}
/* 雨量柱图例：满格口径只由 utils/rainImpact.js 给出，这里不重复写数字 */
.hour-legend{margin-left:auto;white-space:nowrap;color:#7190a5;font-size:20rpx;font-weight:400}

/* ===== 乡镇短临：按需获取（未展开不取数，也不给任何降雨结论） ===== */
.nowcast-head{position:relative;transition:transform var(--qd-t-fast) var(--qd-ease-spring)}
.nowcast-head:active{transform:scale(.985)}
.nowcast-toggle{margin-left:14rpx;padding:14rpx 24rpx;border-radius:999rpx;color:#0e4d64;font-size:22rpx;font-weight:700;letter-spacing:.5rpx;background:linear-gradient(180deg,#eaf7fc 0%,#e1f2fa 100%);box-shadow:0 4rpx 12rpx rgba(14,77,100,.1),inset 0 1rpx 0 rgba(255,255,255,.9)}
.nowcast-idle{min-height:88rpx;padding:22rpx 24rpx;border:1rpx dashed rgba(169,191,203,.62);border-radius:20rpx;background:linear-gradient(180deg,#fbfdff 0%,#f4fafd 100%)}
.nowcast-idle-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx}
.nowcast-idle-badge{padding:6rpx 16rpx;border-radius:999rpx;color:#7d8b96;background:#eef4f8;font-size:22rpx;font-weight:600}
.nowcast-idle-hint{color:#8aa5b4;font-size:22rpx}
.nowcast-idle-desc{color:#7190a5;font-size:22rpx;line-height:1.55}
.nowcast-loading{display:flex;align-items:center;padding:8rpx 0 4rpx}
.nowcast-sk{width:64rpx;height:64rpx;flex-shrink:0;margin-right:18rpx;border-radius:50%}
.nowcast-loading-text{color:#7190a5;font-size:24rpx}

/* —— 短临数据完整性：取数失败绝不冒充「无雨」，失败乡镇单列并标注 —— */
.nowcast-integrity{display:flex;align-items:center;margin-bottom:16rpx;padding:14rpx 18rpx;border:1rpx solid rgba(215,232,240,.9);border-radius:16rpx;background:#f4fafd;color:#4f7b91;font-size:22rpx;line-height:1.45}
.nowcast-integrity .integrity-dot{flex-shrink:0;width:12rpx;height:12rpx;margin-right:12rpx;border-radius:50%;background:#35a3c4}
.nowcast-integrity .integrity-text{flex:1;min-width:0}
.nowcast-integrity.warn{border-color:rgba(212,154,42,.28);background:#fff8e8;color:#9a6a12}
.nowcast-integrity.warn .integrity-dot{background:#d49a2a}
.township-status.missing{color:#7d8b96;background:#eef4f8;border:1rpx solid rgba(125,139,150,.2)}
.township-missing{margin-top:4rpx;padding:16rpx 18rpx;border:1rpx dashed rgba(169,191,203,.62);border-radius:14rpx;color:#8aa5b4;font-size:22rpx;line-height:1.5}
.nowcast-reason{margin-top:12rpx;padding:14rpx 18rpx;border-radius:14rpx;color:#8a7960;background:rgba(255,248,232,.72);font-size:22rpx;line-height:1.5}
