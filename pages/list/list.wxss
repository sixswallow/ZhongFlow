@import "../../assets/icons.wxss";

.page{min-height:100vh;padding-bottom:calc(156rpx + env(safe-area-inset-bottom));background:#f4f8fc}

/* ============================================================
   搜索栏：sticky 玻璃 + 聚焦光环
   ============================================================ */
.search-bar{position:sticky;top:0;padding:20rpx 24rpx 16rpx;background:linear-gradient(180deg,rgba(244,248,252,.98) 0%,rgba(244,248,252,.92) 70%,rgba(244,248,252,.6) 100%);backdrop-filter:blur(20rpx) saturate(1.3);z-index:100}
.search-box{display:flex;align-items:center;height:88rpx;padding:0 22rpx;border:1rpx solid rgba(215,232,240,.94);border-radius:24rpx;background:linear-gradient(180deg,#ffffff 0%,#fdfeff 100%);box-shadow:var(--qd-e1),var(--qd-hairline-top);transition:box-shadow var(--qd-t-base) var(--qd-ease),border-color var(--qd-t-base) var(--qd-ease),transform var(--qd-t-base) var(--qd-ease-spring)}
.search-box:focus-within{border-color:rgba(14,155,184,.42);box-shadow:0 0 0 4rpx rgba(14,155,184,.14),0 10rpx 26rpx rgba(14,77,100,.12),var(--qd-hairline-top);transform:translateY(-2rpx)}
.search-icon{width:28rpx;height:28rpx;margin-right:14rpx;opacity:.72;transition:opacity var(--qd-t-base) ease}
.search-box:focus-within .search-icon{opacity:1}
.search-input{flex:1;color:#123a4a;font-size:27rpx}
.search-clear{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:50%;color:#8aa5b4;background:#eef4f8;font-size:26rpx;line-height:1;transition:transform var(--qd-t-fast) var(--qd-ease-spring),background var(--qd-t-fast) ease}
.search-clear:active{transform:scale(.86);background:#e2edf4}

/* ============================================================
   数据加载失败横幅：与「暂无数据」区分，提供重试入口
   ============================================================ */
.load-failed-banner{display:flex;align-items:center;justify-content:space-between;margin:16rpx 24rpx 0;padding:18rpx 24rpx;border:1rpx solid rgba(217,95,95,.22);border-radius:20rpx;background:linear-gradient(180deg,#fff6f5 0%,#fffdfd 100%);box-shadow:var(--qd-e1)}
.load-failed-banner:active{transform:scale(.985)}
.load-failed-text{flex:1;margin-right:16rpx;color:#a03a2a;font-size:25rpx}
.load-failed-retry{flex-shrink:0;padding:8rpx 20rpx;border-radius:999rpx;color:#c33d25;background:#fff2f0;border:1rpx solid rgba(217,95,95,.24);font-size:24rpx;font-weight:600}

/* ============================================================
   分段控件：滑块随分类平移
   ============================================================ */
.tab-bar{position:relative;display:flex;margin:12rpx 24rpx 0;padding:7rpx;overflow:hidden;border:1rpx solid rgba(215,232,240,.94);border-radius:22rpx;background:linear-gradient(180deg,#ffffff 0%,#fbfdff 100%);box-shadow:var(--qd-e1),var(--qd-hairline-top)}

.tab-slider{position:absolute;top:7rpx;bottom:7rpx;left:7rpx;width:calc((100% - 14rpx) / 3);border:1rpx solid rgba(14,155,184,.2);border-radius:16rpx;background:linear-gradient(180deg,rgba(14,155,184,.14) 0%,rgba(14,155,184,.05) 100%);box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9),0 6rpx 14rpx rgba(14,77,100,.08);transition:transform .4s cubic-bezier(.34,1.4,.5,1);pointer-events:none}
.tab-slider-line{position:absolute;top:-7rpx;left:50%;width:40rpx;height:4rpx;margin-left:-20rpx;border-radius:999rpx;background:linear-gradient(90deg,rgba(14,155,184,0) 0%,#0e9bb8 50%,rgba(14,155,184,0) 100%)}
.tab-bar.active-reservoir .tab-slider{transform:translateX(0)}
.tab-bar.active-river .tab-slider{transform:translateX(100%)}
.tab-bar.active-soil .tab-slider{transform:translateX(200%)}

.tab-item{position:relative;display:flex;flex:1;flex-direction:column;align-items:center;padding:15rpx 0;border-radius:16rpx;z-index:1;transition:transform var(--qd-t-fast) var(--qd-ease-spring)}
.tab-item:active{transform:scale(.94)}
.tab-text{margin-bottom:6rpx;color:#6b8798;font-size:27rpx;transition:color var(--qd-t-base) ease}
.tab-item.active .tab-text{color:#0b4f8a;font-weight:700}
.tab-count{padding:2rpx 12rpx;border-radius:999rpx;color:#8098a9;background:#eef4f8;font-size:22rpx;transition:all var(--qd-t-base) ease}
.tab-item.active .tab-count{color:#0e6a80;background:#ffffff;box-shadow:0 2rpx 8rpx rgba(14,77,100,.1)}

/* ============================================================
   站点卡片
   ============================================================ */
.station-list{padding:24rpx}
.station-item{position:relative;display:flex;align-items:center;margin-bottom:18rpx;overflow:hidden;padding:24rpx 24rpx 24rpx 28rpx;border:1rpx solid rgba(215,232,240,.92);border-radius:24rpx;background:linear-gradient(180deg,#ffffff 0%,#fdfeff 100%);box-shadow:var(--qd-e2),var(--qd-hairline-top);transition:transform var(--qd-t-base) var(--qd-ease-spring),box-shadow var(--qd-t-base) var(--qd-ease)}
.station-item:active{transform:scale(.982);box-shadow:var(--qd-e1),var(--qd-hairline-top)}

/* 左侧类型强调条 */
.item-accent{position:absolute;top:22rpx;bottom:22rpx;left:0;width:6rpx;border-radius:0 6rpx 6rpx 0}
.item-accent.reservoir{background:linear-gradient(180deg,#1f8fc4,#0e6a80)}
.item-accent.river{background:linear-gradient(180deg,#12a5ac,#0a7d86)}
.item-accent.soil{background:linear-gradient(180deg,#79b545,#4f7a14)}

.item-icon{display:flex;align-items:center;justify-content:center;width:84rpx;height:84rpx;flex-shrink:0;margin-right:20rpx;border:1rpx solid transparent;border-radius:22rpx;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9);transition:transform var(--qd-t-base) var(--qd-ease-spring)}
.station-item:active .item-icon{transform:scale(.94)}
.item-icon .ic{width:38rpx;height:38rpx}
.item-icon.reservoir{background:linear-gradient(150deg,#eaf8fd,#d7f0f9);border-color:rgba(31,143,196,.16)}
.item-icon.river{background:linear-gradient(150deg,#e6fbfb,#d5f4f4);border-color:rgba(18,165,172,.16)}
.item-icon.soil{background:linear-gradient(150deg,#f4fbe8,#e8f5d6);border-color:rgba(95,158,58,.16)}

.item-content{min-width:0;flex:1}
.item-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:9rpx}
.item-name{overflow:hidden;flex:1;margin-right:14rpx;color:#123a4a;font-size:30rpx;font-weight:700;letter-spacing:.5rpx;text-overflow:ellipsis;white-space:nowrap}
.item-status{flex-shrink:0;padding:6rpx 14rpx;border:1rpx solid rgba(14,155,184,.14);border-radius:999rpx;color:#0e6a80;background:#e6f7fc;font-size:22rpx;font-weight:600}
.item-status.warning,.item-status.dry{color:#a96900;background:#fff8e8;border-color:rgba(212,154,42,.2)}
.item-status.danger,.item-status.drought{color:#c33d25;background:#fff2f0;border-color:rgba(217,95,95,.2)}
.item-status.wet{color:#0e6a80;background:#e6f7fc;border-color:rgba(14,155,184,.14)}
.item-status.unknown{color:#5e7f90;background:#eef4f8;border-color:rgba(94,127,144,.2)}
.item-address{overflow:hidden;margin-bottom:16rpx;color:#7d96a8;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}
.item-data{display:flex;padding-top:16rpx;border-top:1rpx solid #eef4f8}
.data-col{min-width:112rpx;padding-right:18rpx}
.data-value{display:block;color:#0e4d64;font-size:27rpx;font-weight:700;letter-spacing:-.5rpx}
.data-label{display:block;margin-top:6rpx;color:#8aa5b4;font-size:22rpx}
.item-arrow{margin-left:12rpx;color:#8fc7d8;font-size:35rpx;transition:transform var(--qd-t-base) var(--qd-ease-spring)}
.station-item:active .item-arrow{transform:translateX(6rpx)}

/* ============================================================
   空态
   ============================================================ */
.empty-state{padding:90rpx 24rpx;text-align:center}
.empty-icon{width:96rpx;height:96rpx;margin:0 auto;opacity:.5;animation:qd-float 6s ease-in-out infinite}
.empty-text{margin-top:20rpx;color:#5e7f90;font-size:26rpx;font-weight:600}
.empty-hint{margin-top:10rpx;color:#a9bfcb;font-size:22rpx}

/* ===== 触控命中区补强（≥88rpx≈44pt） ===== */
.search-clear{position:relative}
.search-clear::after{position:absolute;top:-18rpx;right:-10rpx;bottom:-18rpx;left:-10rpx;content:''}
