@import "../assets/icons.wxss";

/* ============================================================
   悬浮玻璃胶囊导航（青黛 v4）
   ============================================================ */
.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 0 24rpx calc(14rpx + env(safe-area-inset-bottom));
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  z-index: 999;
}

.tab-bar-plate {
  position: relative;
  display: flex;
  height: 112rpx;
  padding: 8rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow:
    0 2rpx 4rpx rgba(14, 77, 100, 0.06),
    0 14rpx 32rpx rgba(14, 77, 100, 0.16),
    0 30rpx 60rpx rgba(14, 77, 100, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(26rpx) saturate(1.5);
  -webkit-backdrop-filter: blur(26rpx) saturate(1.5);
  box-sizing: border-box;
}

/* 滑动药丸：由 selected 驱动位移，纯 CSS 过渡 */
.tab-pill {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  width: calc((100% - 16rpx) / 4);
  border: 1rpx solid rgba(14, 155, 184, 0.2);
  border-radius: 26rpx;
  background: linear-gradient(180deg, rgba(14, 155, 184, 0.16) 0%, rgba(14, 155, 184, 0.06) 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    0 6rpx 16rpx rgba(14, 77, 100, 0.09);
  transition: transform 0.42s cubic-bezier(0.34, 1.4, 0.5, 1);
  pointer-events: none;
}

.tab-pill-line {
  position: absolute;
  top: -8rpx;
  left: 50%;
  width: 44rpx;
  height: 4rpx;
  margin-left: -22rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(14, 155, 184, 0) 0%, #0e9bb8 50%, rgba(14, 155, 184, 0) 100%);
}

.tab-bar-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 1;
}

.tab-bar-item:active {
  transform: scale(0.9);
}

.tab-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 5rpx;
  transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.68;
  transition: opacity 0.26s ease;
}

.tab-bar-item.active .tab-icon-wrap {
  transform: translateY(-3rpx) scale(1.12);
}

.tab-bar-item.active .tab-icon {
  opacity: 1;
}

.tab-text {
  color: #8aa5b4;
  font-size:22rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  transition: color 0.26s ease, transform 0.26s ease;
}

.tab-bar-item.active .tab-text {
  color: #0e4d64;
  font-weight: 700;
}
